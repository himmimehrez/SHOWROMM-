# Copier en .env.local et renseigner les valeurs du projet Supabase (Project Settings > API)
# La cle anon public est faite pour etre visible dans le navigateur. Ne jamais mettre la cle service_role ici.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=
# supabase (defaut) ou demo (base de demonstration dans le navigateur)
VITE_BACKEND=supabase
